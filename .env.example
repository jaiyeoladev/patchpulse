# Copy to .env and fill in. Never commit .env.

# --- Mode -------------------------------------------------------------
# true  = realistic synthetic data, nothing leaves the machine
# false = read your tenant (requires the credentials below)
DEMO_MODE=true

# --- Web app security ---------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# Required (12+ chars) when DEMO_MODE=false. In demo mode the default is changeme-demo.
ADMIN_PASSWORD=
# Optional read-only account for auditors / managers
VIEWER_USERNAME=auditor
VIEWER_PASSWORD=
# Optional bearer token for the JSON API (/api/summary, /api/findings)
API_TOKEN=
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# --- Storage & scheduling ----------------------------------------------
DATABASE_PATH=data/patchpulse.db
# Run a scan automatically every N hours (0 = manual only)
SCAN_INTERVAL_HOURS=0
CURRENCY_SYMBOL=£

# --- Microsoft Graph (Entra ID app registration, application permissions) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# National clouds only:
# GRAPH_BASE_URL=https://graph.microsoft.us/v1.0
# GRAPH_BETA_BASE_URL=https://graph.microsoft.us/beta
# AZURE_AUTHORITY=https://login.microsoftonline.us

# --- CrowdStrike Falcon (optional; API client with Hosts: Read + Vulnerabilities: Read) ---
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
# us-1, us-2, eu-1, us-gov-1 or a full https:// URL
FALCON_BASE_URL=eu-1
